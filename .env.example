# Weaviate Cloud (WCD) Credentials
# Create a free cluster at: https://console.weaviate.cloud/
WEAVIATE_URL=https://your-cluster-url.weaviate.cloud
WEAVIATE_API_KEY=your_weaviate_api_key_here

# Groq Cloud API Key
# Obtain free from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key (Direct high-speed query embeddings in app.py)
# Obtain free from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Portkey Configuration for Gemini Embeddings (Used for document batch ingestion in store_index.py)
# Obtain from: https://app.portkey.ai/
PORTKEY_API_KEY=your_portkey_api_key_here
PORTKEY_EMBEDDING_CONFIG_ID=your_portkey_embedding_config_id_here
PORTKEY_EMBEDDING_MODEL=gemini-embedding-2

# LangSmith Tracing & Observability
# Obtain from: https://smith.langchain.com/
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=MediRAG_AI


